# ===============================================
# Dark Social Swarm - Environment Configuration
# ===============================================

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o

# Reddit PRAW Configuration (Public Community Ingestion)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DarkSocialSwarm/0.1.0 by your_reddit_username
REDDIT_SUBREDDITS=SaaS,startups,Entrepreneur,smallbusiness,marketing

# Database & Storage
SQLITE_DB_PATH=dark_social_swarm.db
CHECKPOINTER_DB_PATH=swarm_checkpointer.db

# Swarm Evaluation Thresholds
OPPORTUNITY_SCORE_THRESHOLD=40
MAX_CRITIC_RETRIES=2

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
